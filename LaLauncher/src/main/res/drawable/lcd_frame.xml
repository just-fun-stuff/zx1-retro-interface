<?xml version="1.0" encoding="utf-8"?>
<!-- Bezel on top and bottom only: the glass runs edge to edge, so the side
     bands are pushed off-view with negative insets (design call, 2026-07-19). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="-4dp" android:right="-4dp">
        <shape><solid android:color="@color/chassis_edge" /></shape>
    </item>
    <item android:left="-1dp" android:top="3dp" android:right="-1dp" android:bottom="3dp">
        <shape><solid android:color="@color/lcd_surface" /><stroke android:width="1dp" android:color="#050706" /></shape>
    </item>
</layer-list>
