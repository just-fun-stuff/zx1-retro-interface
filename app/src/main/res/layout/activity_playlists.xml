<?xml version="1.0" encoding="utf-8"?>
<!-- PLAYLISTS (C2): the launcher's own lists and Sony's read-only ones, in
     the library browser's mechanism - chassis header, one glass list, a
     function key inside the glass. The three overlays are the same idiom as
     the library's task menu: opaque chassis, one LCD panel. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pl_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chassis_black">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp">

            <TextView
                android:id="@+id/pl_back"
                style="@style/DrawerControl"
                android:layout_width="72dp"
                android:text="▼ HOME" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/pl_title_label"
                    style="@style/PanelMicroLabel"
                    android:text="PLAYLISTS" />

                <TextView
                    android:id="@+id/pl_status"
                    style="@style/PanelMicroLabel"
                    android:layout_width="match_parent"
                    android:singleLine="true"
                    android:text="READING PLAYLISTS..."
                    android:textColor="@color/panel_dim" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pl_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:background="@drawable/lcd_frame"
            android:orientation="vertical"
            android:padding="10dp">

            <ListView
                android:id="@+id/pl_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:cacheColorHint="@color/lcd_surface"
                android:divider="@color/lcd_ink_dim"
                android:dividerHeight="1dp"
                android:listSelector="@drawable/lcd_row_selected"
                android:scrollbarStyle="outsideOverlay" />

            <TextView
                android:id="@+id/pl_new"
                style="@style/LcdSoftKey"
                android:layout_marginTop="8dp"
                android:text="NEW PLAYLIST" />

            <TextView
                android:id="@+id/pl_hint"
                style="@style/LcdSmall"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:gravity="center_vertical"
                android:text="TAP: OPEN  HOLD: MENU  ▼: BACK" />
        </LinearLayout>
    </LinearLayout>

    <!-- Task menu and confirmations: one panel, two numbered functions. -->
    <FrameLayout
        android:id="@+id/pl_menu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chassis_black"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pl_menu_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/lcd_frame"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/pl_menu_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:textColor="@color/lcd_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pl_menu_sub"
                style="@style/LcdSmall"
                android:layout_width="match_parent"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/lcd_ink_dim" />

            <TextView
                android:id="@+id/pl_menu_key1"
                style="@style/LcdSoftKey"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/pl_menu_key2"
                style="@style/LcdSoftKey"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/pl_menu_hint"
                style="@style/LcdSmall"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="TAP: SELECT    ▼: CANCEL" />
        </LinearLayout>
    </FrameLayout>

    <!-- Naming a list: the same panel with a recessed field. -->
    <FrameLayout
        android:id="@+id/pl_input"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chassis_black"
        android:clickable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/pl_input_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/lcd_frame"
            android:clickable="true"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/pl_input_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:text="NEW PLAYLIST"
                android:textColor="@color/lcd_ink"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/pl_input_field"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/lcd_search"
                android:fontFamily="monospace"
                android:hint="NAME"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters"
                android:maxLength="40"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:singleLine="true"
                android:textColor="@color/lcd_ink"
                android:textColorHint="@color/lcd_ink_dim"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/pl_input_save"
                style="@style/LcdSoftKey"
                android:layout_marginTop="12dp"
                android:text="1  SAVE" />

            <TextView
                android:id="@+id/pl_input_cancel"
                style="@style/LcdSoftKey"
                android:layout_marginTop="4dp"
                android:text="2  CANCEL" />
        </LinearLayout>
    </FrameLayout>

    <!-- Storage overlay: the shared storage panel in the same idiom, while
         the music volume is out of reach. Topmost, and eats touches while
         visible; back leaves the screen. -->
    <FrameLayout
        android:id="@+id/pl_storage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/chassis_black"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/pl_storage_frame"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginLeft="24dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/lcd_frame"
            android:padding="14dp">

            <include layout="@layout/storage_panel" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
